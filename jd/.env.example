# ============================================================
# 大模型服务配置模板（复制为 .env 后填入你自己的 key）
# 通过编号 LLM_PROVIDER_N_* 声明降级链，按 N 从小到大依次尝试。
#
# 每个 provider 四个字段：
#   NAME      服务商名称（仅日志用，可任意）
#   BASE_URL  接口地址（见下方规则）
#   API_KEY   密钥
#   FORMAT    接口格式：chat 或 responses
#   MODELS    模型降级链，逗号分隔
#
# BASE_URL 规则：
#   ① 以 /chat/completions 结尾 → 直接作为 chat 端点
#   ② 以 /responses 结尾        → 直接作为 responses 端点
#   ③ 否则视为 base，自动拼接：
#        chat      -> {base}/chat/completions
#        responses -> {base}/responses
# ============================================================

# ----- 示例：OpenAI 官方（responses 格式）-----
LLM_PROVIDER_1_NAME=openai
LLM_PROVIDER_1_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_1_API_KEY=sk-你的openai-key
LLM_PROVIDER_1_FORMAT=responses
LLM_PROVIDER_1_MODELS=gpt-5-mini,gpt-4o-mini

# ----- 示例：OpenRouter（chat 格式）-----
# LLM_PROVIDER_2_NAME=openrouter
# LLM_PROVIDER_2_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER_2_API_KEY=sk-or-你的key
# LLM_PROVIDER_2_FORMAT=chat
# LLM_PROVIDER_2_MODELS=deepseek/deepseek-chat,google/gemma-4-31b-it:free

# ----- 示例：DeepSeek（chat 格式）-----
# LLM_PROVIDER_3_NAME=deepseek
# LLM_PROVIDER_3_BASE_URL=https://api.deepseek.com/v1
# LLM_PROVIDER_3_API_KEY=sk-你的deepseek-key
# LLM_PROVIDER_3_FORMAT=chat
# LLM_PROVIDER_3_MODELS=deepseek-chat

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000

# ===== 可选调优 =====
REQUEST_TIMEOUT=120
RETRY_COUNT=1
MAX_INPUT_CHARS=4000
MAX_TECH_STACK=30
